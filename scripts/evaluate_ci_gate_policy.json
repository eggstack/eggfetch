{
  "required_jobs": [
    "rust-format",
    "rust-lint",
    "rust-msrv",
    "rust-test",
    "rust-doc",
    "docs-syntax",
    "docs-runtime",
    "resource-monitor",
    "python",
    "wheel-smoke",
    "compat-httpx"
  ],
  "conditional_jobs": {
    "docs-runtime": "Depends on rust-test; skipped when rust-test is skipped"
  },
  "allowed_skip_results": ["success", "skipped"],
  "fail_results": ["failure", "cancelled"]
}
